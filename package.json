
{
  "name": "smokelyze-site",
  "private": true,
  "dependencies": {
    "@google-cloud/storage": "^7.12.1",
    "firebase-admin": "^12.0.0"
  },
  "devDependencies": {
    "terser": "^5.31.1",
    "clean-css-cli": "^5.6.3"
  },
  "scripts": {
    "build": "hugo && npm run minify",
    "minify": "npm run minify:js && npm run minify:css",
    "minify:js": "find public/js -name '*.js' -exec npx terser {} -o {} -c \"pure_funcs=['console.log']\" -m ';'",
    "minify:css": "find public/css -name '*.css' -exec npx clean-css-cli -o {} {} ';'"
  }
}

